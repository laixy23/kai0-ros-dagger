<launch>
  <!-- Cameras only: this file starts no Piper nodes or motion publishers. -->
  <!-- Parameters verified against IntelRealSense/realsense-ros tag 2.3.2. -->
  <arg name="front_serial" default="263022074037" />
  <arg name="left_serial" default="263022070737" />
  <arg name="right_serial" default="263022072753" />
  <arg name="color_width" default="640" />
  <arg name="color_height" default="480" />
  <arg name="color_fps" default="30" />

  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="camera_f" />
    <arg name="serial_no" value="$(arg front_serial)" />
    <arg name="color_width" value="$(arg color_width)" />
    <arg name="color_height" value="$(arg color_height)" />
    <arg name="color_fps" value="$(arg color_fps)" />
    <arg name="enable_color" value="true" />
    <arg name="enable_depth" value="false" />
    <arg name="enable_confidence" value="false" />
    <arg name="enable_infra" value="false" />
    <arg name="enable_infra1" value="false" />
    <arg name="enable_infra2" value="false" />
    <arg name="enable_pointcloud" value="false" />
    <arg name="initial_reset" value="false" />
  </include>
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="camera_l" />
    <arg name="serial_no" value="$(arg left_serial)" />
    <arg name="color_width" value="$(arg color_width)" />
    <arg name="color_height" value="$(arg color_height)" />
    <arg name="color_fps" value="$(arg color_fps)" />
    <arg name="enable_color" value="true" />
    <arg name="enable_depth" value="false" />
    <arg name="enable_confidence" value="false" />
    <arg name="enable_infra" value="false" />
    <arg name="enable_infra1" value="false" />
    <arg name="enable_infra2" value="false" />
    <arg name="enable_pointcloud" value="false" />
    <arg name="initial_reset" value="false" />
  </include>
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="camera_r" />
    <arg name="serial_no" value="$(arg right_serial)" />
    <arg name="color_width" value="$(arg color_width)" />
    <arg name="color_height" value="$(arg color_height)" />
    <arg name="color_fps" value="$(arg color_fps)" />
    <arg name="enable_color" value="true" />
    <arg name="enable_depth" value="false" />
    <arg name="enable_confidence" value="false" />
    <arg name="enable_infra" value="false" />
    <arg name="enable_infra1" value="false" />
    <arg name="enable_infra2" value="false" />
    <arg name="enable_pointcloud" value="false" />
    <arg name="initial_reset" value="false" />
  </include>
</launch>
